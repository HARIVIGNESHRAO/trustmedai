DATABASE_URL=jdbc:postgresql://HOST/DATABASE?sslmode=require
DATABASE_USERNAME=database_user
DATABASE_PASSWORD=replace_me

GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
MICROSOFT_CLIENT_ID=replace_me
MICROSOFT_CLIENT_SECRET=replace_me

JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRATION=86400000

SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_me
TURNSTILE_SECRET_KEY=replace_me

FRONTEND_URL=http://localhost:3000
AI_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost,capacitor://localhost
PORT=8080

JPA_SHOW_SQL=false
SECURITY_LOG_LEVEL=INFO
MAIL_LOG_LEVEL=INFO
FABRIC_ENABLED=false
